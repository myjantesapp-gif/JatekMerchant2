{
  "cli": {
    "version": ">=21.3.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "node": "20",
      "pnpm": "10.26.1",
      "developmentClient": true,
      "distribution": "internal",
      "credentialsSource": "remote",
      "cache": {
        "key": "gradle-driver-dev-v1",
        "paths": ["~/.gradle/caches", "~/.gradle/wrapper"]
      },
      "env": {
        "EXPO_PUBLIC_PROJECT_ID": "3c515b02-249e-427b-a45f-e15e22e4f25d",
        "EXPO_PUBLIC_DOMAIN": "ma.jatek.app",
        "EXPO_OWNER": "jatekplatforms-team",
        "EXPO_SLUG": "jatekdriver",
        "PNPM_VERSION": "10.26.1",
        "npm_config_frozen_lockfile": "false",
        "pnpm_config_frozen_lockfile": "false",
        "NODE_VERSION": "20"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "preview": {
      "node": "20",
      "pnpm": "10.26.1",
      "distribution": "internal",
      "channel": "preview",
      "credentialsSource": "remote",
      "autoIncrement": true,
      "cache": {
        "key": "gradle-driver-preview-v1",
        "paths": ["~/.gradle/caches", "~/.gradle/wrapper"]
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "ma.jatek.app",
        "EXPO_PUBLIC_PROJECT_ID": "3c515b02-249e-427b-a45f-e15e22e4f25d",
        "EXPO_OWNER": "jatekplatforms-team",
        "EXPO_SLUG": "jatekdriver",
        "PNPM_VERSION": "10.26.1",
        "npm_config_frozen_lockfile": "false",
        "pnpm_config_frozen_lockfile": "false",
        "NODE_VERSION": "20",
        "EAS_UPDATE_CHANNEL": "preview"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "production": {
      "node": "20",
      "pnpm": "10.26.1",
      "channel": "production",
      "credentialsSource": "remote",
      "autoIncrement": true,
      "cache": {
        "key": "gradle-driver-prod-v1",
        "paths": ["~/.gradle/caches", "~/.gradle/wrapper"]
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "ma.jatek.app",
        "EXPO_PUBLIC_API_URL": "https://ma.jatek.app",
        "EXPO_PUBLIC_PROJECT_ID": "3c515b02-249e-427b-a45f-e15e22e4f25d",
        "EXPO_OWNER": "jatekplatforms-team",
        "EXPO_SLUG": "jatekdriver",
        "PNPM_VERSION": "10.26.1",
        "npm_config_frozen_lockfile": "false",
        "pnpm_config_frozen_lockfile": "false",
        "NODE_VERSION": "20",
        "EAS_UPDATE_CHANNEL": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
