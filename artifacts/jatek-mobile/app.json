{
  "expo": {
    "name": "Jatek",
    "slug": "jatek",
    "owner": "jatekapp",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/jatek-app-icon.png",
    "scheme": "jatek",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/jatek-intro-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E80868"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ma.jatek.app",
      "buildNumber": "7",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Jatek utilise votre position uniquement pendant l’utilisation de l’application pour renseigner votre adresse et vérifier la zone de livraison à Oujda.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ma.jatek.app",
      "versionCode": 19,
      "edgeToEdgeEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/jatek-app-icon.png",
        "backgroundColor": "#E50064"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#E80868",
      "barStyle": "light-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#E80868",
      "barStyle": "light-content",
      "enforceContrast": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "Jatek utilise votre position uniquement pendant l’utilisation de l’application pour renseigner votre adresse."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Jatek utilise vos photos uniquement lorsque vous choisissez une image de profil."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/jatek-notification-icon.png",
          "color": "#E91E63",
          "defaultChannel": "default",
          "androidMode": "default"
        }
      ],
      "expo-video"
    ],
    "updates": {
      "url": "https://u.expo.dev/73e947fb-0a5a-4064-aafe-c856e231c9d4"
    },
    "runtimeVersion": "1.0.1",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "73e947fb-0a5a-4064-aafe-c856e231c9d4"
      }
    }
  }
}
