{
  "expo": {
    "name": "Jatek Merchant",
    "slug": "merchant",
    "owner": "jateksys",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jatek-merchant-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "app.jatek.merchant",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez Jatek Merchant à accéder à vos photos pour illustrer votre menu et votre boutique.",
          "cameraPermission": "Autorisez Jatek Merchant à photographier vos produits et votre boutique."
        }
      ],
      "expo-sharing",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "894f0535-7157-444f-9641-a4e0f2430b98"
      }
    }
  }
}
