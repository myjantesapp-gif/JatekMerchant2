{
  "expo": {
    "name": "Jatek Merchant",
    "slug": "jatek-merchant-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jatek-merchant-mobile",
    "splash": {
      "image": "./assets/images/merchant-loading-splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#e60968"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
