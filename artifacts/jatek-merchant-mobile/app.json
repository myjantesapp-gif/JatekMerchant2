{
  "expo": {
    "name": "Jatek Merchant",
    "slug": "jatek-merchant-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jatek-merchant-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez Jatek Merchant à accéder à vos photos pour illustrer votre menu et votre boutique.",
          "cameraPermission": "Autorisez Jatek Merchant à photographier vos produits et votre boutique."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
