{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "node": "20.20.0",
      "pnpm": "10.26.1",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "image": "sdk-57"
      },
      "env": {
        "NODE_ENV": "production",
        "EAS_UPDATE_CHANNEL": "preview",
        "EXPO_PUBLIC_PROJECT_ID": "894f0535-7157-444f-9641-a4e0f2430b98",
        "EXPO_PUBLIC_API_URL": "https://api.jatek.app"
      }
    },
    "production": {
      "node": "20.20.0",
      "pnpm": "10.26.1",
      "distribution": "store",
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "image": "sdk-57"
      },
      "env": {
        "NODE_ENV": "production",
        "EAS_UPDATE_CHANNEL": "production",
        "EXPO_PUBLIC_PROJECT_ID": "894f0535-7157-444f-9641-a4e0f2430b98",
        "EXPO_PUBLIC_API_URL": "https://api.jatek.app"
      }
    }
  }
}
