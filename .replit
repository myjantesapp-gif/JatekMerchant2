modules = ["nodejs-20", "web", "bash", "python-base-3.13", "java-graalvm22.3", "postgresql-16"]

  [deployment]
  router = "application"
deploymentTarget = "autoscale"
run = ["bash", "scripts/start-production.sh"]
build = ["bash", "scripts/build-production.sh"]

  [deployment.postBuild]
  args = ["pnpm", "store", "prune"]
  env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "artifacts/jatek-mobile: web"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "EAS_UPDATE_CHANNEL=preview PORT=25896 pnpm --filter @workspace/jatek-mobile run preview"
waitForPort = 25896

[[workflows.workflow]]
name = "artifacts/jatek-landing: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/jatek-landing"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/jatek-landing run dev"
cwd = "./artifacts/jatek-landing"
waitForPort = 5000
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "5000"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "artifacts/jatek-mobile: expo"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/jatek-mobile"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/jatek-mobile run dev"
cwd = "./artifacts/jatek-mobile"
waitForPort = 3000
ensurePreviewReachable = "/"
router = "expo-domain"

[workflows.workflow.tasks.env]
PORT = "3000"
BASE_PATH = "/mobile/"

[[workflows.workflow]]
name = "artifacts/backend-dashboard: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/backend-dashboard"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/backend-dashboard run dev"
cwd = "./artifacts/backend-dashboard"
waitForPort = 19167
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "19167"
BASE_PATH = "/admin/"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8080"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/jatek-driver: expo"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/jatek-mobile: web"

[[workflows.workflow]]
name = "artifacts/jatek-driver: expo"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8099 EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_PROJECT_ID=$EXPO_PUBLIC_PROJECT_ID EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm --filter @workspace/jatek-driver exec expo start --lan --port 8099"

  [agent]
  stack = "BEST_EFFORT_FALLBACK"
expertMode = true
  integrations = ["twilio:1.0.0"]

  [postMerge]
  path = "scripts/post-merge.sh"
  timeoutMs = 20000

  [nix]
channel = "stable-25_05"
packages = ["eas-cli", "freetype", "gir-rs", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "unzipNLS", "xcbuild"]

  [userenv]

  [userenv.shared]
JATEK_APP_STORAGE_BUCKET_ID = "replit-objstore-f5ac68cb-059e-4ebb-a9d9-fe5c9411da99"

